# wokil-frontend environment contract.
# Copy to .env.local for dev. NEXT_PUBLIC_* vars are baked in at BUILD time —
# Vercel needs this set in project settings, not just at runtime.

# Backend base URL including the /api suffix (legacy axios paths omit it; the
# generated SDK strips the suffix itself — see src/lib/api-client.ts).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8090/api
